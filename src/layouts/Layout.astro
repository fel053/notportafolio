---
// src/layouts/Layout.astro
import '../styles/global.css';
import NavStatus from '../components/vue/NavStatus.vue';
import VisibilityController from '../components/vue/VisibilityController.vue';
import ClientRouter from 'astro/components/ClientRouter.astro';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>// PORTAFOLIO</title>
    <ClientRouter />
  </head>
  <body>
    <nav class="site-nav" transition:persist>
      <a href="/" class="nav-brand">
        <span class="nav-bracket">[</span>
        <span class="nav-name neon-flicker">PORT_</span>
        <span class="nav-bracket">]</span>
      </a>
      <div class="nav-right">
        <NavStatus client:only="vue" />
        <a href="/cv" class="nav-link">CV</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>
    <VisibilityController client:only="vue" />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-line">
          <span class="footer-left">> SYS.EOF</span>
          <span class="footer-center">Sí, esto también está medido.</span>
          <span class="footer-right">2026</span>
        </div>
        <div class="footer-glow"></div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ─── Nav ──────────────────────────────────────────── */
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem var(--pad-x);
    background: linear-gradient(to bottom, rgba(6,6,9,.92), transparent);
    border-bottom: 1px solid rgba(0,229,255,.08);
  }

  .nav-brand {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    transition: filter 0.3s;
  }
  .nav-brand:hover { filter: brightness(1.3); }

  .nav-bracket {
    color: rgba(0,229,255,.4);
    font-size: 0.9rem;
  }
  .nav-name {
    color: var(--cyan);
    text-shadow: var(--glow-c);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-status {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: rgba(0,229,255,.4);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-status::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
    animation: neon-flicker 4s infinite;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--fg-2);
    border: 1px solid transparent;
    padding: 0.35rem 0.8rem;
    transition: all 0.3s;
  }
  .nav-link:hover {
    color: var(--cyan);
    border-color: rgba(0,229,255,.35);
    box-shadow: 0 0 8px rgba(0,229,255,.15);
  }

  /* ─── Footer ────────────────────────────────────────── */
  .site-footer {
    position: relative;
    margin-top: 2rem;
    border-top: 1px solid rgba(0,229,255,.1);
    overflow: hidden;
  }

  .footer-inner {
    padding: 2rem var(--pad-x) 2.5rem;
    max-width: var(--max-w);
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  .footer-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--fg-3);
  }

  .footer-center {
    color: rgba(0,229,255,.25);
    text-transform: uppercase;
    font-size: 0.55rem;
  }

  .footer-glow {
    position: absolute;
    bottom: -20px; left: 50%;
    transform: translateX(-50%);
    width: 60%; height: 60px;
    background: radial-gradient(ellipse, rgba(0,229,255,.06), transparent 70%);
    pointer-events: none;
  }
</style>
